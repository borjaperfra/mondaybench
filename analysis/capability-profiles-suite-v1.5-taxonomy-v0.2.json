{
  "taxonomy_version": "0.2",
  "scenarios": [
    "monday-001",
    "monday-002",
    "monday-003",
    "monday-004",
    "monday-005"
  ],
  "note": "Capability scores are points earned divided by points available on the criteria mapped to that capability, with each criterion averaged across the model's official runs first - the same aggregation the scenario score uses. Scoring uses primary mappings only, so no criterion's points are counted twice. Scores are comparable across models, not across capabilities: the weighting is the rubrics' own point mass, not a claim about importance.",
  "capabilities": [
    {
      "id": "quantitative_reasoning",
      "group": "reasoning",
      "description": "Compute a business figure correctly and choose the right basis for it: rates against the right denominator, distributions rather than averages, like-for-like comparisons, and normalisation before comparison.",
      "criteria": 16,
      "points": 66.0,
      "scenarios": [
        "monday-001",
        "monday-002",
        "monday-004",
        "monday-005"
      ],
      "sparse": false
    },
    {
      "id": "prioritization",
      "group": "execution_and_judgment",
      "description": "Identify which items require action now, order them against each other, and keep resolved, delegated or cosmetic items from displacing real work.",
      "criteria": 11,
      "points": 60.0,
      "scenarios": [
        "monday-001",
        "monday-002",
        "monday-003"
      ],
      "sparse": false
    },
    {
      "id": "state_reconstruction",
      "group": "information_handling",
      "description": "Determine the current state of a thing - an incident, a release, a contract, a piece of work - from evidence that is scattered across sources and partly out of date. The failure mode is reporting a state that was true earlier.",
      "criteria": 13,
      "points": 50.0,
      "scenarios": [
        "monday-001",
        "monday-002",
        "monday-003",
        "monday-005"
      ],
      "sparse": false
    },
    {
      "id": "planning",
      "group": "execution_and_judgment",
      "description": "Produce a sequence that actually runs: the right option chosen, work parallelised where it can be, and the schedule coherent with its own dependencies.",
      "criteria": 5,
      "points": 30.0,
      "scenarios": [
        "monday-002",
        "monday-003"
      ],
      "sparse": false
    },
    {
      "id": "supersession",
      "group": "information_handling",
      "description": "Recognise that a later source overrides an earlier one, and act on the later one. Distinct from state reconstruction: here both facts are present and explicit, and the question is which of them still holds.",
      "criteria": 6,
      "points": 27.0,
      "scenarios": [
        "monday-002",
        "monday-003",
        "monday-005"
      ],
      "sparse": false
    },
    {
      "id": "dependency_reasoning",
      "group": "reasoning",
      "description": "Reconstruct what must happen before what, identify the chain that sets a delivery date, and keep work that is not on that chain off it.",
      "criteria": 5,
      "points": 25.0,
      "scenarios": [
        "monday-002",
        "monday-003"
      ],
      "sparse": false
    },
    {
      "id": "action_safety",
      "group": "execution_and_judgment",
      "description": "Decline actions the evidence rules out - sending confidential material externally, acting on a superseded instruction, scaling spend on a misleading figure, chasing an item that is already closed.",
      "criteria": 4,
      "points": 23.0,
      "scenarios": [
        "monday-001",
        "monday-002",
        "monday-004"
      ],
      "sparse": false
    },
    {
      "id": "causal_discipline",
      "group": "reasoning",
      "description": "Refuse a causal claim the evidence does not support, while still reporting the pattern. The failure mode is a plausible mechanism stated as a finding.",
      "criteria": 8,
      "points": 23.0,
      "scenarios": [
        "monday-001",
        "monday-002",
        "monday-004",
        "monday-005"
      ],
      "sparse": false
    },
    {
      "id": "uncertainty_calibration",
      "group": "reasoning",
      "description": "Identify what cannot be determined from the sources, say so, and name the evidence that would settle it - rather than producing a number or a verdict anyway.",
      "criteria": 7,
      "points": 23.0,
      "scenarios": [
        "monday-001",
        "monday-002",
        "monday-003",
        "monday-004",
        "monday-005"
      ],
      "sparse": false
    },
    {
      "id": "business_judgment",
      "group": "execution_and_judgment",
      "description": "Turn an analysis into a decision a leadership team can act on, choosing the metric the decision actually depends on, and stating the conclusion rather than leaving it in the workings.",
      "criteria": 6,
      "points": 21.0,
      "scenarios": [
        "monday-004"
      ],
      "sparse": true
    },
    {
      "id": "resource_allocation",
      "group": "execution_and_judgment",
      "description": "Resolve contention for a scarce person or window, including choosing what that person should not do.",
      "criteria": 3,
      "points": 21.0,
      "scenarios": [
        "monday-003"
      ],
      "sparse": true
    },
    {
      "id": "cross_source_reconciliation",
      "group": "information_handling",
      "description": "Build one finding from several sources that no single source supports, and refuse a finding that one source appears to support but another explains away.",
      "criteria": 4,
      "points": 18.0,
      "scenarios": [
        "monday-002",
        "monday-004"
      ],
      "sparse": false
    },
    {
      "id": "audience_adaptation",
      "group": "communication",
      "description": "Decide what a particular reader needs from a body of facts, and give them that rather than everything or a summary of everything. The failure mode is one document written four times: correct in substance, wrong for three of its readers. Distinct from writing quality, which MondayBench does not measure - the judgment is about selection and level, not expression.",
      "criteria": 5,
      "points": 17.0,
      "scenarios": [
        "monday-005"
      ],
      "sparse": true
    },
    {
      "id": "cross_output_consistency",
      "group": "communication",
      "description": "Represent one underlying reality across several separately targeted artifacts so that no two of them assert incompatible states. Explicitly NOT uniformity: differing levels of detail, differing framing, and a fact present in one artifact and absent from another are all consistent. Only a contradiction of factual or commitment state counts. Cannot be measured by a scenario that produces one output, which is why nothing before monday-005 covers it.",
      "criteria": 4,
      "points": 16.0,
      "scenarios": [
        "monday-005"
      ],
      "sparse": true
    },
    {
      "id": "ownership_and_delegation",
      "group": "execution_and_judgment",
      "description": "Establish who currently owns a piece of work, and route work to the person who should hold it.",
      "criteria": 3,
      "points": 14.0,
      "scenarios": [
        "monday-001",
        "monday-002",
        "monday-003"
      ],
      "sparse": false
    },
    {
      "id": "temporal_reasoning",
      "group": "reasoning",
      "description": "Reason about dates, durations, deadlines and availability windows, and decide what is reachable within them.",
      "criteria": 3,
      "points": 14.0,
      "scenarios": [
        "monday-002",
        "monday-003"
      ],
      "sparse": false
    },
    {
      "id": "information_boundaries",
      "group": "communication",
      "description": "Keep information that must not cross a confidentiality line on the correct side of it. SUPPRESSION only: internal technical and security detail, one customer's identity in front of another, personal data in a public artifact, and internal architecture. Distinct from `action_safety`, which is declining an ACTION the evidence rules out; here nothing is recommended and the disclosure is itself the harm. Deliberately does NOT cover making sure a fact ARRIVES - see `information_routing`.",
      "criteria": 6,
      "points": 13.0,
      "scenarios": [
        "monday-005"
      ],
      "sparse": true
    },
    {
      "id": "commitment_discipline",
      "group": "communication",
      "description": "Distinguish an internal estimate from an authorised external promise, and commit the organisation only to what someone has actually approved. Adjacent to `uncertainty_calibration`, which asks whether the model knows what it does not know; this asks whether it knows what it is allowed to say.",
      "criteria": 3,
      "points": 10.0,
      "scenarios": [
        "monday-005"
      ],
      "sparse": true
    },
    {
      "id": "data_cleaning",
      "group": "information_handling",
      "description": "Detect and correct artifacts in the data itself - duplicated records, values recorded on a basis that is not comparable - before computing anything from them.",
      "criteria": 2,
      "points": 10.0,
      "scenarios": [
        "monday-004"
      ],
      "sparse": true
    },
    {
      "id": "factual_accuracy",
      "group": "information_handling",
      "description": "Carry supplied values - deadlines, durations, owners, counts, totals - through the whole answer without substituting different ones. Not about deriving the right figure; about not corrupting a figure already given.",
      "criteria": 2,
      "points": 8.0,
      "scenarios": [
        "monday-003",
        "monday-004"
      ],
      "sparse": false
    },
    {
      "id": "information_routing",
      "group": "communication",
      "description": "Deliver a fact to the internal audience that needs it in order to act. The mirror image of `information_boundaries`: that capability is about what must not leave, this one about what must arrive. They are separated because monday-005 measured them separately and they came apart - across 21 official runs no model disclosed any of the four explicit confidential classes externally, while the criterion asking whether the same security item reached the engineering handoff was the most-failed criterion in the scenario. Suppression and delivery are not one skill.",
      "criteria": 2,
      "points": 7.0,
      "scenarios": [
        "monday-005"
      ],
      "sparse": true
    },
    {
      "id": "entity_resolution",
      "group": "information_handling",
      "description": "Join records about the same entity whose identifiers differ between files, and notice when a naive join has silently dropped one.",
      "criteria": 1,
      "points": 4.0,
      "scenarios": [
        "monday-004"
      ],
      "sparse": true
    }
  ],
