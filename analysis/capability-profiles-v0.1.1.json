      ],
      "sparse": true
    },
    {
      "id": "state_reconstruction",
      "group": "information_handling",
      "description": "Determine the current state of a thing - an incident, a release, a contract, a piece of work - from evidence that is scattered across sources and partly out of date. The failure mode is reporting a state that was true earlier.",
      "criteria": 7,
      "points": 30.0,
      "scenarios": [
        "monday-001",
        "monday-002",
        "monday-003"
      ],
      "sparse": false
    },
    {
      "id": "supersession",
      "group": "information_handling",
      "description": "Recognise that a later source overrides an earlier one, and act on the later one. Distinct from state reconstruction: here both facts are present and explicit, and the question is which of them still holds.",
      "criteria": 5,
      "points": 23.0,
      "scenarios": [
