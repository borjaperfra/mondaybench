  "limitations": [
    {
      "issue": "byte-identical input was counted as 3 different prompt-token totals [72, 98, 151]",
      "consequence": "the samples were not all answered under one accounting, and reasoning tokens differ by group, so the baseline/high difference cannot be attributed to reasoning_effort. See input_token_accounting."
    },
    {
      "issue": "success rate is saturated at 1.0 in both variants",
      "consequence": "gate A could not have fired whatever reasoning_effort does. This prompt cannot discriminate quality, so 'no quality effect' is NOT established - it was not measurable. The zero-width bootstrap CI on the success-rate difference is an artefact of that ceiling, not precision."
    },
    {
      "issue": "the two procedures disagree on the median reasoning-token difference at the 5% threshold",
      "detail": "permutation p=0.0253, bootstrap 95% CI [-812.0, 5.5] (includes zero: True)",
      "consequence": "neither is treated as a finding. Four tests were run and no multiplicity correction was applied, so a single p-value near 0.05 is not evidence of an effect."
    },
    {
      "issue": "scope",
      "consequence": "one prompt, one route, one model, one session, calls issued sequentially. Interleaving controls for slow backend drift, not for load at the moment of a call. Nothing here generalises to other prompts or to MondayBench scenarios."
    },
    {
      "issue": "observable behaviour only",
      "consequence": "request-id shapes, token counters and stream events are descriptions of responses. They establish nothing about how the provider routes or serves a request internally."
    }
  ],
