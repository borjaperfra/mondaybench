# Copy to `.env` and fill in the keys. `.env` is gitignored; never commit it.
# Existing exported environment variables always win over this file.

# ---------------------------------------------------------------------------
# Benchmarked models
# ---------------------------------------------------------------------------

# Helmcode - the default endpoint for benchmarked models.
# Base URL from https://helmcode.com/es/docs/models
HELMCODE_BASE_URL=https://api.helmcode.com/v1
HELMCODE_API_KEY=

# NaN - used only for models Helmcode does not serve (MIMO, and the newer GLM
# and Qwen that are not in the public docs yet).
# Confirm the base URL against https://nan.builders/docs/getting-started
NAN_BASE_URL=
NAN_API_KEY=

# ---------------------------------------------------------------------------
# Judge - pick ONE of the options below
# ---------------------------------------------------------------------------

# Option A: DISALLOWED ON THIS PROJECT - claude-opus-5 on the Anthropic API.
#
# Leave this blank. Judging is done in a recorded Claude Code session and the
# labels are replayed with `mondaybench evaluate --verdicts`, so no Anthropic
# API key is needed and none may be used. Spending Anthropic API credits here
# is a hard rule violation, not a cost trade-off. See README, "The judge".
ANTHROPIC_API_KEY=

# Option B: evaluator-open-v0.1 - an open model on infrastructure you already
# pay for. Zero marginal cost, and no closed model judging open ones.
# Point these at Helmcode (or NaN) and pick the strongest model available.
JUDGE_BASE_URL=https://api.helmcode.com/v1
JUDGE_API_KEY=
JUDGE_MODEL=glm-5.2

# Option C: evaluator-manual-v0.1 - verdicts recorded in a worksheet file.
# Needs no credentials at all. See `mondaybench worksheet --help`.

# Note on Option B via Helmcode: Helmcode also serves `claude-opus-5` under
# Frontier Models (pay-per-token from Helmcode credits). Setting
# JUDGE_MODEL=claude-opus-5 reaches the same model as Option A without a
# separate Anthropic key - but through an OpenAI-compatible gateway, so
# structured-output and effort support are whatever the gateway forwards. If you
# want that model as the official judge, Option A is the reliable route.
